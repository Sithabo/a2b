{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["apps/api/**", "packages/core/**", "Dockerfile", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node ace escrow:expire",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
