# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=a2b_dev

# Phone OTP — "log" prints codes to the server log instead of sending SMS
SMS_DRIVER=log
OTP_TEST_NUMBERS=+256700000001=123456,+5926000001=123456,+256700000002=123456,+5926000002=123456,+256700000003=123456,+5926000003=123456

# Escrow payments — "mock" simulates mobile money / card providers
PAYMENT_DRIVER=mock
DRIVE_DISK=fs