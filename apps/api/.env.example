# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=a2b_dev

# Texts — "log" prints them to the server log; "twilio" sends real SMS (needs TWILIO_* below)
SMS_DRIVER=log
# Sign-in codes — "local" makes codes here and texts them with SMS_DRIVER;
# "twilio_verify" lets Twilio Verify send and check them (works for US numbers without 10DLC)
OTP_DRIVER=local
# Real numbers outside Guyana/Uganda allowed to sign in, with the market their account uses
# (e.g. testing from the US). Format: +14055550123=UG,+12125550199=GY
OTP_TESTER_PHONES=
# Show the code on the sign-in screen of dev builds (only works with SMS_DRIVER=log, never in production)
OTP_EXPOSE_CODES=true
OTP_TEST_NUMBERS=+256700000001=123456,+5926000001=123456,+256700000002=123456,+5926000002=123456,+256700000003=123456,+5926000003=123456

# Twilio — console.twilio.com. Auth token, or an API key (SK…) + its secret in TWILIO_AUTH_TOKEN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
# Verify service (VA…) for OTP_DRIVER=twilio_verify
TWILIO_VERIFY_SERVICE_SID=
# Sender for SMS_DRIVER=twilio: a Messaging Service (MG…), or a number / alphanumeric sender ID
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Rate limiting store: database (default) or memory
LIMITER_STORE=database

# Escrow payments — "mock" simulates mobile money / card providers
PAYMENT_DRIVER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# Minutes a shipper has to fund escrow before the load goes back on the board
ESCROW_FUNDING_WINDOW_MINUTES=240
DRIVE_DISK=fs
# Place search: catalog (curated places only) or google (needs GOOGLE_MAPS_API_KEY, server-side)
PLACES_PROVIDER=catalog
GOOGLE_MAPS_API_KEY=
