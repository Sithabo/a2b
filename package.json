{
  "name": "a2b",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "shipper": "npm run start -w @a2b/shipper",
    "fleet": "npm run start -w @a2b/fleet",
    "api": "npm run dev -w @a2b/api",
    "test:api": "npm run test -w @a2b/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~54.0.37",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
